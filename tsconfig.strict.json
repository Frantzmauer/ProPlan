{
  // Obliczenia, dane i synchronizacja (app/lib) oraz testy: TypeScript w trybie ścisłym.
  // Moduł przechodzi tutaj, gdy dostanie pełne typy (bez łagodnych typów elementów strony).
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["app/lib/**/*.ts", "tests/**/*.ts"]
}
