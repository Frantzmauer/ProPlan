{
  // Ekrany i funkcje (app/screens, features, core, plan, diet, ui): TypeScript stopniowo.
  // Bez trybu ścisłego i z łagodniejszymi typami elementów strony (app/types/dom-loose.d.ts),
  // dopóki moduły nie dostaną własnych typów. Obliczenia w app/lib sprawdza ściśle tsconfig.strict.json.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["app/**/*.ts", "app/**/*.js"],
  "exclude": ["app/sw.js"]
}
